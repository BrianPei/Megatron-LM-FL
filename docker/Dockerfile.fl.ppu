# Build context: repository root. Requires the wheels listed in docker/ppu/wheels.sha256.
ARG BASE_IMAGE=harbor.baai.ac.cn/flagos-dev/flagcx@sha256:34b2106d0fb9ce090d1ff346e3043bb865004f0e53e1920dd3454f4f0c015883
FROM ${BASE_IMAGE}
USER root
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG TE_FL_COMMIT=3d077fe87080bdd93f8ab96db6afd67fc63f8b89
ARG FLAGGEMS_COMMIT=649ee9a34958b0338604a0214637f29c685fcbf9
ENV TE_FL_SKIP_CUDA=1 \
    TE_FL_PREFER=flagos \
    NVTE_FRAMEWORK=pytorch \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates git curl unzip && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

COPY docker/ppu/constraints.txt docker/ppu/requirements.txt /opt/megatron-ppu-ci/
ENV PIP_CONSTRAINT=/opt/megatron-ppu-ci/constraints.txt
RUN python3 -m pip install --no-cache-dir -r /opt/megatron-ppu-ci/requirements.txt

# Vendor SSM wheels must match Torch 2.10/cp312/PPU SDK 2.1; never use stock CUDA wheels.
COPY docker/ppu/wheels/ /opt/megatron-ppu-ci/wheels/
COPY docker/ppu/wheels.sha256 /opt/megatron-ppu-ci/wheels/
RUN cd /opt/megatron-ppu-ci/wheels && sha256sum -c wheels.sha256 && \
    python3 -m pip install --no-deps --no-index --find-links=. \
      'mamba-ssm==2.3.1+v0.1.0.ppu2.1.0.ce' \
      'causal-conv1d==1.6.2.post1+v0.1.0.ppu2.1.0.ce' \
      nvidia-modelopt==0.45.0 pulp==3.3.2

COPY .github/docker/build_te_fl_native.sh .github/scripts/install_te_fl_runtime.sh /opt/megatron-ppu-ci/
RUN git init /opt/ci-src/TransformerEngine-FL && \
    git -C /opt/ci-src/TransformerEngine-FL remote add origin https://github.com/flagos-ai/TransformerEngine-FL.git && \
    git -C /opt/ci-src/TransformerEngine-FL fetch --depth=1 origin "${TE_FL_COMMIT}" && \
    git -C /opt/ci-src/TransformerEngine-FL checkout --detach FETCH_HEAD && \
    test "$(git -C /opt/ci-src/TransformerEngine-FL rev-parse HEAD)" = "${TE_FL_COMMIT}" && \
    TE_FL_REPO=/opt/ci-src/TransformerEngine-FL OUTPUT_DIR=/opt/ci-wheels/te-fl \
      bash /opt/megatron-ppu-ci/build_te_fl_native.sh && \
    TE_FL_WHEEL_DIR=/opt/ci-wheels/te-fl bash /opt/megatron-ppu-ci/install_te_fl_runtime.sh

RUN git init /opt/ci-src/FlagGems && \
    git -C /opt/ci-src/FlagGems remote add origin https://github.com/FlagOpen/FlagGems.git && \
    git -C /opt/ci-src/FlagGems fetch --depth=1 origin "${FLAGGEMS_COMMIT}" && \
    git -C /opt/ci-src/FlagGems checkout --detach FETCH_HEAD && \
    test "$(git -C /opt/ci-src/FlagGems rev-parse HEAD)" = "${FLAGGEMS_COMMIT}" && \
    python3 -m pip install --no-deps --no-build-isolation --no-cache-dir /opt/ci-src/FlagGems

# No runner-specific host asset paths: validated archives are included in the image.
RUN mkdir -p /opt/data && cd /opt/data && \
    curl --fail --location --retry 2 --connect-timeout 20 --max-time 1800 \
      -o datasets.zip https://baai-flagscale.ks3-cn-beijing.ksyuncs.com/temp/datasets.zip && \
    echo '2dda736d6daa6ed32c5f866aec7e7915c380e353cd39b05ba2dcb13039225661  datasets.zip' | sha256sum -c - && \
    unzip -t datasets.zip && unzip -q datasets.zip && rm datasets.zip && \
    curl --fail --location --retry 2 --connect-timeout 20 --max-time 1800 \
      -o tokenizers.zip https://baai-flagscale.ks3-cn-beijing.ksyuncs.com/temp/tokenizers.zip && \
    echo '35be75de4ac17e41e6acad8f5a2d5f6ca3f32840183dcb056af544a8b9d58675  tokenizers.zip' | sha256sum -c - && \
    unzip -t tokenizers.zip && unzip -q tokenizers.zip && rm tokenizers.zip

RUN python3 -m pip list --format=json > /opt/megatron-ppu-ci/installed-packages.json

LABEL org.flagos.ppu.te-fl.commit="${TE_FL_COMMIT}" \
      org.flagos.ppu.flaggems.commit="${FLAGGEMS_COMMIT}" \
      org.flagos.ppu.build-method="source-build"
WORKDIR /workspace
ENTRYPOINT []
CMD ["/bin/bash"]
